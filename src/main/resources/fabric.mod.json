{
  "schemaVersion": 1,
  "id": "rpgcrafting",
  "version": "${version}",
  "name": "RPG Crafting",
  "description": "Introduces an alternative/replacement/addition to the traditional crafting system. It is heavily inspired by games like Valheim and Terraria.",
  "authors": [
    "TheRedBrain"
  ],
  "contact": {
    "sources": "https://github.com/TheRedBrain/rpg-crafting"
  },
  "license": "MIT",
  "icon": "assets/rpgcrafting/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.theredbrain.rpgcrafting.RPGCrafting"
    ],
    "client": [
      "com.github.theredbrain.rpgcrafting.RPGCraftingClient"
    ],
    "fabric-datagen": [
      "com.github.theredbrain.rpgcrafting.datagen.RPGCraftingDataGenerator"
    ]
  },
  "custom": {
    "fzzy_config": [
      "rpgcrafting"
    ]
  },
  "mixins": [
    "rpgcrafting.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "fzzy_config": ">=${fzzy_config_version}",
    "slotcustomizationapi": ">=${slot_customization_api_version}"
  }
}
